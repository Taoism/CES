<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Ces.SpotUi"
             x:Class="Ces.SpotUi.SpotView"
             x:DataType="m:FileRow">

  <UserControl.Styles>
    <Style Selector="Border.q">
      <Setter Property="Background" Value="{DynamicResource QualityUnknownBrush}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Margin" Value="2,3" />
    </Style>
    <Style Selector="Border.q.good">
      <Setter Property="Background" Value="{DynamicResource QualityGoodBrush}" />
    </Style>
    <Style Selector="Border.q.fair">
      <Setter Property="Background" Value="{DynamicResource QualityFairBrush}" />
    </Style>
    <Style Selector="Border.q.poor">
      <Setter Property="Background" Value="{DynamicResource QualityPoorBrush}" />
    </Style>
    <Style Selector="Border.q.lossless">
      <Setter Property="Background" Value="{DynamicResource QualityLosslessBrush}" />
    </Style>
    <Style Selector="TextBlock.problem">
      <Setter Property="Foreground" Value="{DynamicResource ProblemBrush}" />
    </Style>
    <Style Selector="DataGridCell TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="MainGrid" ColumnDefinitions="340,5,*">
    <!-- left: same pattern as Compare's Sources (header, buttons, hint, content) -->
    <DockPanel Grid.Column="0" Margin="10,10,4,10">
      <StackPanel DockPanel.Dock="Top" Spacing="8">
        <TextBlock Text="Folders" Classes="h2" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
          <Button Content="Open folder…" Click="OnOpenFolder" />
          <Button Content="Add files…" Click="OnAddFiles" />
          <CheckBox x:Name="SubfoldersBox" Content="Subfolders" IsCheckedChanged="OnSubfoldersBoxChanged" />
        </WrapPanel>
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="Pick a folder, or drop MP3 / FLAC files and folders here. Double-click a file for its details; select two or more to compare them." />
      </StackPanel>
      <m:FolderTree x:Name="FolderTree" Margin="0,10,0,0" />
    </DockPanel>
    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
    <!-- right: toolbar row + file list -->
    <DockPanel Grid.Column="2" Margin="4,10,10,6">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,200" Margin="0,0,0,8">
        <TextBox x:Name="PathBox" Grid.Column="0" PlaceholderText="Folder or file: type a path and press Enter" KeyDown="OnPathKeyDown" />
        <Button x:Name="CompareButton" Grid.Column="1" Margin="6,0,0,0" Content="Compare selected" IsEnabled="False" Click="OnCompareSelected"
                ToolTip.Tip="Open the selected files in Compare mode (2 or more files)" />
        <Button Grid.Column="2" Margin="6,0,6,0" Content="Export…" Click="OnExport" />
        <TextBox x:Name="FilterBox" Grid.Column="3" PlaceholderText="Filter" TextChanged="OnFilterChanged" />
      </Grid>
      <DataGrid x:Name="Grid" IsReadOnly="True" SelectionMode="Extended"
                CanUserSortColumns="True" DoubleTapped="OnGridDoubleTapped" KeyDown="OnGridKeyDown" SelectionChanged="OnGridSelection">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Details…" Click="OnDetails" />
            <MenuItem Header="Compare selected" Click="OnCompareSelected" />
            <MenuItem Header="Open containing folder" Click="OnOpenContaining" />
            <MenuItem Header="Copy path" Click="OnCopyPath" />
            <MenuItem Header="Copy info" Click="OnCopyInfo" />
            <MenuItem Header="Analyze again" Click="OnReanalyze" />
            <Separator />
            <MenuItem Header="Remove from list" Click="OnRemove" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="280" SortMemberPath="Name" />
          <DataGridTextColumn Header="Encoder" Binding="{Binding Encoder}" Width="170" SortMemberPath="Encoder" />
          <DataGridTextColumn Header="Settings" Binding="{Binding Settings}" Width="220" SortMemberPath="Settings" />
          <DataGridTextColumn Header="kbps" Binding="{Binding BitrateText}" Width="84" SortMemberPath="Bitrate" />
          <DataGridTextColumn Header="Length" Binding="{Binding LengthText}" Width="92" SortMemberPath="Seconds" />
          <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="96" SortMemberPath="Size" />
          <DataGridTextColumn Header="VBR" Binding="{Binding VbrText}" Width="74" SortMemberPath="VbrText" />
          <DataGridTemplateColumn Header="Quality" Width="88" SortMemberPath="QualitySort">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:FileRow">
                <Border Classes="q" IsVisible="{Binding IsDone}" Classes.good="{Binding IsGood}" Classes.fair="{Binding IsFair}"
                        Classes.poor="{Binding IsPoor}" Classes.lossless="{Binding IsLossless}">
                  <TextBlock Text="{Binding QualityText}" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="94" SortMemberPath="Format" />
          <DataGridTextColumn Header="Hz" Binding="{Binding SampleRateText}" Width="80" SortMemberPath="SampleRate" />
          <DataGridTextColumn Header="Mode" Binding="{Binding ModeText}" Width="110" SortMemberPath="ModeText" />
          <DataGridTextColumn Header="Frames" Binding="{Binding FramesText}" Width="98" SortMemberPath="Frames" />
          <DataGridTextColumn Header="Guess" Binding="{Binding Confidence}" Width="84" SortMemberPath="Confidence" />
          <DataGridTemplateColumn Header="Problems" Width="320" SortMemberPath="Problems">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:FileRow">
                <TextBlock Classes="problem" Text="{Binding Problems}" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Problems}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="140" SortMemberPath="Artist" />
          <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="160" SortMemberPath="Title" />
          <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="260" SortMemberPath="Folder" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </Grid>
</UserControl>
