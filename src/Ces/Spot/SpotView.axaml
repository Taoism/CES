<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:EncoderSpot.Models"
        x:Class="EncoderSpot.MainWindow"
        x:DataType="m:FileRow"
        Title="EncoderSpot"
        Icon="avares://EncoderSpot/Assets/encoderspot.png"
        MinWidth="760" MinHeight="420"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <Style Selector="Border.q">
      <Setter Property="Background" Value="{DynamicResource QualityUnknownBrush}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Margin" Value="2,3" />
    </Style>
    <Style Selector="Border.q.good">
      <Setter Property="Background" Value="{DynamicResource QualityGoodBrush}" />
    </Style>
    <Style Selector="Border.q.fair">
      <Setter Property="Background" Value="{DynamicResource QualityFairBrush}" />
    </Style>
    <Style Selector="Border.q.poor">
      <Setter Property="Background" Value="{DynamicResource QualityPoorBrush}" />
    </Style>
    <Style Selector="Border.q.lossless">
      <Setter Property="Background" Value="{DynamicResource QualityLosslessBrush}" />
    </Style>
    <Style Selector="TextBlock.problem">
      <Setter Property="Foreground" Value="{DynamicResource ProblemBrush}" />
    </Style>
    <Style Selector="DataGridCell TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open folder…" InputGesture="Ctrl+O" Click="OnOpenFolder" />
        <MenuItem Header="_Add files…" InputGesture="Ctrl+Shift+O" Click="OnAddFiles" />
        <MenuItem Header="_Rescan" InputGesture="F5" Click="OnRescan" />
        <Separator />
        <MenuItem Header="_Export report…" InputGesture="Ctrl+E" Click="OnExport" />
        <MenuItem Header="_Copy list as text" Click="OnCopyList" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="SubfoldersMenu" Header="Include _subfolders" ToggleType="CheckBox" Click="OnToggleSubfolders" />
        <MenuItem x:Name="ProblemsMenu" Header="Only files with _problems" ToggleType="CheckBox" Click="OnToggleProblems" />
        <MenuItem x:Name="DecodeMenu" Header="_Decode FLAC (CRC + MD5 check)" ToggleType="CheckBox" Click="OnToggleDecode" />
        <Separator />
        <MenuItem Header="_Details…" InputGesture="Enter" Click="OnDetails" />
        <Separator />
        <MenuItem Header="_Theme">
          <MenuItem x:Name="ThemeSystem" Header="Follow _system" ToggleType="Radio" GroupName="theme" Click="OnTheme" Tag="System" />
          <MenuItem x:Name="ThemeDark" Header="_Dark" ToggleType="Radio" GroupName="theme" Click="OnTheme" Tag="Dark" />
          <MenuItem x:Name="ThemeLight" Header="_Light" ToggleType="Radio" GroupName="theme" Click="OnTheme" Tag="Light" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About EncoderSpot" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Padding="8,6" Classes="footer">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,180">
        <TextBox x:Name="PathBox" Grid.Column="0" PlaceholderText="Folder or file — type a path and press Enter, or drop files here" KeyDown="OnPathKeyDown" />
        <Button Grid.Column="1" Margin="6,0,0,0" Content="Browse…" Click="OnOpenFolder" />
        <CheckBox x:Name="SubfoldersBox" Grid.Column="2" Margin="10,0,0,0" Content="Subfolders" IsCheckedChanged="OnSubfoldersBoxChanged" />
        <Button x:Name="StopButton" Grid.Column="3" Margin="6,0,10,0" Content="Stop" IsEnabled="False" Click="OnStop" />
        <TextBox x:Name="FilterBox" Grid.Column="4" PlaceholderText="Filter" TextChanged="OnFilterChanged" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="footer" Padding="10,4">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" Classes="muted" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <TextBlock x:Name="ProgressText" Classes="muted" VerticalAlignment="Center" />
          <ProgressBar x:Name="Progress" Width="160" MinHeight="6" Height="6" IsVisible="False" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="MainGrid" ColumnDefinitions="260,4,*">
      <TreeView x:Name="FolderTree" Grid.Column="0" SelectionChanged="OnTreeSelection">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="m:FolderNode">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="m:FolderNode" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" />
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
      <DataGrid x:Name="Grid" Grid.Column="2" IsReadOnly="True" SelectionMode="Extended"
                CanUserSortColumns="True" DoubleTapped="OnGridDoubleTapped" KeyDown="OnGridKeyDown">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Details…" Click="OnDetails" />
            <MenuItem Header="Open containing folder" Click="OnOpenContaining" />
            <MenuItem Header="Copy path" Click="OnCopyPath" />
            <MenuItem Header="Copy info" Click="OnCopyInfo" />
            <MenuItem Header="Analyze again" Click="OnReanalyze" />
            <Separator />
            <MenuItem Header="Remove from list" Click="OnRemove" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="280" SortMemberPath="Name" />
          <DataGridTextColumn Header="Encoder" Binding="{Binding Encoder}" Width="170" SortMemberPath="Encoder" />
          <DataGridTextColumn Header="Settings" Binding="{Binding Settings}" Width="220" SortMemberPath="Settings" />
          <DataGridTextColumn Header="kbps" Binding="{Binding BitrateText}" Width="70" SortMemberPath="Bitrate" />
          <DataGridTextColumn Header="Length" Binding="{Binding LengthText}" Width="92" SortMemberPath="Seconds" />
          <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="96" SortMemberPath="Size" />
          <DataGridTextColumn Header="VBR" Binding="{Binding VbrText}" Width="64" SortMemberPath="VbrText" />
          <DataGridTemplateColumn Header="Quality" Width="88" SortMemberPath="QualitySort">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:FileRow">
                <Border Classes="q" IsVisible="{Binding IsDone}" Classes.good="{Binding IsGood}" Classes.fair="{Binding IsFair}"
                        Classes.poor="{Binding IsPoor}" Classes.lossless="{Binding IsLossless}">
                  <TextBlock Text="{Binding QualityText}" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="80" SortMemberPath="Format" />
          <DataGridTextColumn Header="Hz" Binding="{Binding SampleRateText}" Width="72" SortMemberPath="SampleRate" />
          <DataGridTextColumn Header="Mode" Binding="{Binding ModeText}" Width="110" SortMemberPath="ModeText" />
          <DataGridTextColumn Header="Frames" Binding="{Binding FramesText}" Width="84" SortMemberPath="Frames" />
          <DataGridTextColumn Header="Guess" Binding="{Binding Confidence}" Width="84" SortMemberPath="Confidence" />
          <DataGridTemplateColumn Header="Problems" Width="320" SortMemberPath="Problems">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="m:FileRow">
                <TextBlock Classes="problem" Text="{Binding Problems}" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Problems}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="140" SortMemberPath="Artist" />
          <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="160" SortMemberPath="Title" />
          <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="260" SortMemberPath="Folder" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</Window>
