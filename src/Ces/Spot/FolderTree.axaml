<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Ces.SpotUi"
             x:Class="Ces.SpotUi.FolderTree">
  <UserControl.Styles>
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <Border Classes="panel">
    <TreeView x:Name="Tree" SelectionChanged="OnSelection" DoubleTapped="OnDoubleTapped" KeyDown="OnKeyDown">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="m:FolderNode">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
      </TreeView.Styles>
      <TreeView.ContextMenu>
        <ContextMenu x:Name="Menu">
          <MenuItem x:Name="ActivateItem" Header="Add as source" Click="OnActivateClick" />
          <MenuItem Header="Open in file manager" Click="OnShowClick" />
        </ContextMenu>
      </TreeView.ContextMenu>
      <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="m:FolderNode" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            <Border Classes="tag" IsVisible="{Binding HasTag}">
              <TextBlock Text="{Binding Tag}" FontSize="10.5" Classes="muted" />
            </Border>
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </Border>
</UserControl>
