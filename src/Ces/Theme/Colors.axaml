      <SolidColorBrush x:Key="ThumbBackgroundBrush" Color="#FF17181B" />
      <SolidColorBrush x:Key="FindingWarnBrush" Color="#FFE0A040" />
      <SolidColorBrush x:Key="FindingBadBrush" Color="#FFE87070" />
      <SolidColorBrush x:Key="MessageErrorBrush" Color="#FFE06060" />
      <SolidColorBrush x:Key="DiffHighlightBrush" Color="#28E0A040" />
      <SolidColorBrush x:Key="OverlayBrush" Color="#C8141518" />
      <SolidColorBrush x:Key="OverlayTextBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ChartTooltipBrush" Color="#E618191C" />
