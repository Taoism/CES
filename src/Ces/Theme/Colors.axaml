<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    App colours per theme. Use them with DynamicResource so switching Light / Dark / Follow system
    repaints everything. Dark: nothing light around controls (dark grey outlines only).
  -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="QualityGoodBrush" Color="#FF2F6B3A" />
      <SolidColorBrush x:Key="QualityFairBrush" Color="#FF7A6A24" />
      <SolidColorBrush x:Key="QualityPoorBrush" Color="#FF7E3434" />
      <SolidColorBrush x:Key="QualityLosslessBrush" Color="#FF2B5F86" />
