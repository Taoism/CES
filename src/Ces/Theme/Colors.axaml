      <SolidColorBrush x:Key="ChartBarBrush" Color="#FF3D7FD6" />
      <SolidColorBrush x:Key="ChartLineBrush" Color="#FF6FB1FF" />
      <SolidColorBrush x:Key="ChartAltBrush" Color="#FFE0A34A" />
      <SolidColorBrush x:Key="ChartGridBrush" Color="#FF2E3036" />
      <SolidColorBrush x:Key="ProblemBrush" Color="#FFE07A6E" />
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF1B1C1F" />
      <SolidColorBrush x:Key="PanelBrush" Color="#FF222428" />
      <SolidColorBrush x:Key="PanelAltBrush" Color="#FF282A2F" />
      <SolidColorBrush x:Key="EdgeBrush" Color="#FF3A3C42" />
